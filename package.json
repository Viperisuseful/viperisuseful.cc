{
  "name": "viperisuseful-portfolio",
  "version": "1.0.0",
  "description": "Static Viper project hub published with GitHub Pages",
  "scripts": {
    "start": "npx serve . -l $PORT",
    "hub:dev": "npm --prefix nightly-src run dev",
    "hub:test": "npm --prefix nightly-src run test -- --run",
    "hub:build": "npm --prefix nightly-src run build",
    "hub:e2e": "npm --prefix nightly-src run e2e"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "serve": "^14.2.4"
  }
}
